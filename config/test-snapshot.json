{
  "ui": {
    "show_snapshots": true,
    "title": "zbm-rs snapshot test"
  },
  "manager": {
    "restart_limit": 2
  },
  "zfs": {
    "import_policy": "host-id"
  },
  "nixos": {
    "generation_limit": 3
  },
  "kernel_args": [
    "quiet",
    "zbm.test=1",
    "zbm.snapshot-test=1"
  ],
  "boot": {
    "mode": "menu",
    "timeout_secs": 1,
    "preferred_pool_guid": null
  }
}
