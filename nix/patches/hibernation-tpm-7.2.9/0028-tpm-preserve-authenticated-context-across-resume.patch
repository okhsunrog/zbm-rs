 #define LINUX_EFI_PCR5_LOG_GUID			EFI_GUID(0xb38f9ff0, 0xb8ef, 0xe28f,  0x80, 0x8d, 0xe2, 0x9a, 0xa7, 0xef, 0xb8, 0x8f)
+/* Experimental authenticated-hibernation NULL-primary handoff. */
+#define LINUX_EFI_TPM_RESUME_GUID			EFI_GUID(0x6681e65d, 0xfa83, 0x4e70,  0x9e, 0xc3, 0x23, 0x8f, 0x7a, 0x7f, 0x5e, 0x91)
 
 #define RISCV_EFI_BOOT_PROTOCOL_GUID		EFI_GUID(0xccd15fec, 0x6f73, 0x4eec,  0x83, 0x95, 0x3e, 0x69, 0xe4, 0xb9, 0x40, 0xbf)
 
@@ -655,6 +657,31 @@ extern unsigned long efi_pcr5_log;
 extern bool kernel_tpm_security_available;
 #endif
 
+/*
+ * Reserved ACPI memory is excluded from the RAM image. The restore kernel
+ * publishes a fresh NULL context only after authenticating the entire image.
+ * The old name is part of that signed image and binds the consumer TPM.
+ */
+#define LINUX_EFI_TPM_RESUME_MAGIC	0x31524d5054584e4cULL
+#define LINUX_EFI_TPM_RESUME_VERSION	1
+
+struct linux_efi_tpm_resume {
+	u64 magic;
+	u32 version;
+	u32 size;
+	u32 ready;
+	u8 old_name[TPM2_NAME_SIZE];
+	u8 null_name[TPM2_NAME_SIZE];
+	u8 null_x[EC_PT_SZ];
+	u8 null_y[EC_PT_SZ];
+	u8 null_context[TPM2_MAX_CONTEXT_SIZE];
+};
+
+#ifdef CONFIG_HIBERNATION_TPM_SIGNATURE
+extern unsigned long efi_tpm_resume;
+struct linux_efi_tpm_resume *efi_tpm_resume_map(void);
+#endif
+
 /*
