diff --git a/drivers/firmware/efi/libstub/tpm.c b/drivers/firmware/efi/libstub/tpm.c
index f03490a..e288931 100644
--- a/drivers/firmware/efi/libstub/tpm.c
+++ b/drivers/firmware/efi/libstub/tpm.c
@@ -305,6 +305,27 @@ static efi_status_t efi_tpm_read_pcr5(efi_tcg2_protocol_t *tcg2,
  * later verify that the firmware extended PCR 5 when ExitBootServices()
  * was called.
  */
+static void efi_tpm_allocate_resume(void)
+{
+	efi_guid_t guid = LINUX_EFI_TPM_RESUME_GUID;
+	struct linux_efi_tpm_resume *resume;
+	efi_status_t status;
+
+	if (!IS_ENABLED(CONFIG_HIBERNATION_TPM_SIGNATURE))
+		return;
+	status = efi_bs_call(allocate_pool, EFI_ACPI_RECLAIM_MEMORY,
+			     sizeof(*resume), (void **)&resume);
+	if (status != EFI_SUCCESS)
+		return;
+	memset(resume, 0, sizeof(*resume));
+	resume->magic = LINUX_EFI_TPM_RESUME_MAGIC;
+	resume->version = LINUX_EFI_TPM_RESUME_VERSION;
+	resume->size = sizeof(*resume);
+	status = efi_bs_call(install_configuration_table, &guid, resume);
+	if (status != EFI_SUCCESS)
+		efi_bs_call(free_pool, resume);
+}
+
 void efi_tpm_record_pcr5(void)
 {
 	efi_guid_t tcg2_guid = EFI_TCG2_PROTOCOL_GUID;
@@ -358,6 +379,7 @@ void efi_tpm_record_pcr5(void)
 		efi_err("Unable to install PCR 5 log table\n");
 		goto err_free;
 	}
+	efi_tpm_allocate_resume();
 	return;
 
 err_free:
diff --git a/drivers/firmware/efi/tpm-security.c b/drivers/firmware/efi/tpm-security.c
index aee497d..922a136 100644
--- a/drivers/firmware/efi/tpm-security.c
+++ b/drivers/firmware/efi/tpm-security.c
@@ -18,6 +18,28 @@
 unsigned long __initdata efi_pcr5_log = EFI_INVALID_TABLE_ADDR;
 bool kernel_tpm_security_available __ro_after_init;
 
+#ifdef CONFIG_HIBERNATION_TPM_SIGNATURE
+unsigned long __ro_after_init efi_tpm_resume = EFI_INVALID_TABLE_ADDR;
+
+struct linux_efi_tpm_resume *efi_tpm_resume_map(void)
+{
+	struct linux_efi_tpm_resume *resume;
+
+	if (efi_tpm_resume == EFI_INVALID_TABLE_ADDR)
+		return NULL;
+	resume = memremap(efi_tpm_resume, sizeof(*resume), MEMREMAP_WB);
+	if (!resume)
+		return NULL;
+	if (resume->magic != LINUX_EFI_TPM_RESUME_MAGIC ||
+	    resume->version != LINUX_EFI_TPM_RESUME_VERSION ||
+	    resume->size != sizeof(*resume)) {
+		memunmap(resume);
+		return NULL;
+	}
+	return resume;
+}
+#endif
+
 static int __init efi_tpm_check_pcr5(void)
 {
 	struct linux_efi_pcr5_log *log;
@@ -27,6 +49,18 @@ static int __init efi_tpm_check_pcr5(void)
 	u32 count;
 	int i, rc;
 
+#ifdef CONFIG_HIBERNATION_TPM_SIGNATURE
+	/* Never inherit an armed handoff through an unrelated kexec boot. */
+	struct linux_efi_tpm_resume *resume = efi_tpm_resume_map();
+
+	if (resume) {
+		WRITE_ONCE(resume->ready, 0);
