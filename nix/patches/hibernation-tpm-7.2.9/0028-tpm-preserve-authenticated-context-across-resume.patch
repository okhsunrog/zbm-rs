@@ -510,6 +510,7 @@ int tpm_pm_resume(struct device *dev)
 	if (chip == NULL)
 		return -ENODEV;
 
+	tpm2_hibernate_import(chip);
 	chip->flags &= ~TPM_CHIP_FLAG_SUSPENDED;
 
 	/*
diff --git a/drivers/char/tpm/tpm.h b/drivers/char/tpm/tpm.h
index f26d8d3..a04a6ca 100644
--- a/drivers/char/tpm/tpm.h
+++ b/drivers/char/tpm/tpm.h
@@ -249,6 +249,7 @@ int tpm2_sessions_init(struct tpm_chip *chip);
 void tpm2_free_auth(struct tpm2_auth *auth);
 int tpm2_audit_session_handle(struct tpm_chip *chip, u32 *handle);
 int tpm2_load_null(struct tpm_chip *chip, u32 *null_key);
+int tpm2_create_audited_null(struct tpm_chip *chip, u32 *handle);
 
 extern const u8 tpm2_kernel_nv_magic[TPM2_KERNEL_NV_SIZE];
 void tpm2_kernel_nv_name(bool written, u8 name[TPM2_NULL_NAME_SIZE]);
diff --git a/drivers/char/tpm/tpm2-kernel-key.c b/drivers/char/tpm/tpm2-kernel-key.c
index 3f9f642..4415fa3 100644
--- a/drivers/char/tpm/tpm2-kernel-key.c
+++ b/drivers/char/tpm/tpm2-kernel-key.c
@@ -571,7 +571,8 @@ static const u32 tpm2_kkey_expected_cc[TPM2_KKEY_NR_CMDS] = {
 };
 
 /* Check that the attestation is a session audit, and find its digest */
-static const u8 *tpm2_kkey_attest_digest(const u8 *attest, u16 len)
+static const u8 *tpm2_kkey_attest_digest(const u8 *attest, u16 len,
+				       const u8 *nonce, u16 nonce_len)
 {
 	struct tpm2_rsp r;
 	const u8 *digest;
@@ -582,9 +583,11 @@ static const u8 *tpm2_kkey_attest_digest(const u8 *attest, u16 len)
 	    tpm2_rsp_u16(&r) != TPM2_ST_ATTEST_SESSION_AUDIT)
 		return NULL;
 
-	/* qualifiedSigner, extraData */
-	tpm2_rsp_tpm2b(&r, &size);
+	/* qualifiedSigner, then the freshness challenge in extraData */
 	tpm2_rsp_tpm2b(&r, &size);
+	digest = tpm2_rsp_tpm2b(&r, &size);
+	if (!digest || size != nonce_len || (size && memcmp(digest, nonce, size)))
+		return NULL;
 	/* clockInfo (clock, resetCount, restartCount, safe), firmwareVersion */
 	tpm2_rsp_bytes(&r, 8 + 4 + 4 + 1);
 	tpm2_rsp_bytes(&r, 8);
@@ -759,8 +762,7 @@ static int tpm2_kkey_check_create(const struct tpm2_kkey_entry *e,
  * tpm2_kernel_key_verify() - verify the provenance of a kernel signing key
  * @chip:	the TPM chip
  * @prov:	provenance returned by tpm2_kernel_key_create()
- * @x:		filled with the X coordinate of the key's public key
- * @y:		filled with the Y coordinate of the key's public key
+ * @identity:	verified signing key and the AK that authenticated its provenance
  *
  * Checks that @prov shows the key was created by the kernel:
  *
@@ -779,7 +781,7 @@ static int tpm2_kkey_check_create(const struct tpm2_kkey_entry *e,
  */
 int tpm2_kernel_key_verify(struct tpm_chip *chip,
 			   const struct tpm2_key_provenance *prov,
-			   u8 x[EC_PT_SZ], u8 y[EC_PT_SZ])
+			   struct tpm2_kernel_key_identity *identity)
 {
 	struct tpm2_kkey_entry e[TPM2_KKEY_NR_CMDS];
 	u8 ak_x[EC_PT_SZ], ak_y[EC_PT_SZ];
@@ -829,7 +831,7 @@ int tpm2_kernel_key_verify(struct tpm_chip *chip,
 	if (rc)
 		return rc;
 
-	session_digest = tpm2_kkey_attest_digest(attest, attest_len);
+	session_digest = tpm2_kkey_attest_digest(attest, attest_len, NULL, 0);
 	if (!session_digest)
 		return -EKEYREJECTED;
 
@@ -867,8 +869,74 @@ int tpm2_kernel_key_verify(struct tpm_chip *chip,
 	/* the key was created after a read of the magic value */
 	rc = tpm2_kkey_check_nv_read(&e[1]);
 	if (!rc)
-		rc = tpm2_kkey_check_create(&e[2], x, y);
+		rc = tpm2_kkey_check_create(&e[2], identity->x, identity->y);
+	if (!rc) {
+		memcpy(identity->ak_x, ak_x, sizeof(ak_x));
+		memcpy(identity->ak_y, ak_y, sizeof(ak_y));
+	}
 
 	return rc;
 }
 EXPORT_SYMBOL_GPL(tpm2_kernel_key_verify);
+
+/*
+ * Certify the fresh NULL primary using the AK that authenticated the saved
+ * image. A replayed AK public key or a bus-substituted NULL key is insufficient:
+ * a fresh signed nonce and the exact, locally recorded CreatePrimary audit
+ * transcript must agree. No new TOFU decision is delegated to the old kernel.
+ * Caller holds the chip's ops throughout verification and context export.
+ */
+int tpm2_kernel_null_certify(struct tpm_chip *chip,
+			    const struct tpm2_kernel_key_identity *identity)
+{
+	struct tpm2_signed_audit audit = { };
+	const struct tpm2_audit_entry *log;
+	u8 nonce[SHA256_DIGEST_SIZE], digest[SHA256_DIGEST_SIZE];
+	const u8 *session_digest;
+	struct sha256_ctx ctx;
+	u32 null_key = 0;
+	int rc;
+
+	get_random_bytes(nonce, sizeof(nonce));
+	tpm2_end_auth_session(chip);
+	rc = tpm2_start_auth_session(chip, true);
+	if (rc)
+		goto out;
+	rc = tpm2_create_audited_null(chip, &null_key);
+	if (rc)
+		goto out;
+	rc = tpm2_get_signed_audit_digest(chip, nonce, sizeof(nonce), &audit);
+	if (rc)
+		goto out;
+	rc = -EKEYREJECTED;
+	if (memcmp(audit.ak_x, identity->ak_x, sizeof(audit.ak_x)) ||
+	    memcmp(audit.ak_y, identity->ak_y, sizeof(audit.ak_y)))
+		goto out;
+	sha256(audit.attest, audit.attest_len, digest);
+	rc = tpm2_kernel_key_verify_signature(identity->ak_x, identity->ak_y,
+					     digest, audit.sig_r, audit.sig_s);
+	if (rc)
+		goto out;
+	rc = -EKEYREJECTED;
+	session_digest = tpm2_kkey_attest_digest(audit.attest, audit.attest_len,
+					     nonce, sizeof(nonce));
+	/* The sole HMAC-audited operation above is the fixed NULL CreatePrimary. */
+	if (!session_digest || tpm2_get_audit_log(chip, &log) != 1)
+		goto out;
+	memset(digest, 0, sizeof(digest));
+	sha256_init(&ctx);
+	sha256_update(&ctx, digest, sizeof(digest));
+	sha256_update(&ctx, log[0].cphash, SHA256_DIGEST_SIZE);
+	sha256_update(&ctx, log[0].rphash, SHA256_DIGEST_SIZE);
+	sha256_final(&ctx, digest);
+	if (memcmp(digest, session_digest, sizeof(digest)))
+		goto out;
+	rc = 0;
+out:
+	tpm2_free_signed_audit(&audit);
+	tpm2_end_auth_session(chip);
+	if (null_key)
+		tpm2_flush_context(chip, null_key);
+	memzero_explicit(nonce, sizeof(nonce));
+	return rc;
+}
diff --git a/drivers/char/tpm/tpm2-sessions.c b/drivers/char/tpm/tpm2-sessions.c
index 9fc9588..bc8cea4 100644
--- a/drivers/char/tpm/tpm2-sessions.c
+++ b/drivers/char/tpm/tpm2-sessions.c
@@ -64,6 +64,8 @@
  */
 
 #include "tpm.h"
+#include <linux/efi.h>
+#include <linux/io.h>
 #include <linux/random.h>
 #include <linux/scatterlist.h>
 #include <linux/unaligned.h>
@@ -477,7 +479,7 @@ EXPORT_SYMBOL_GPL(tpm_buf_append_hmac_session);
 #ifdef CONFIG_TCG_TPM2_HMAC
 
 static int tpm2_create_primary(struct tpm_chip *chip, u32 hierarchy,
-			       u32 *handle, u8 *name);
+			       u32 *handle, u8 *name, bool audit);
 
 /*
  * assume hash sha256 and nonces u, v of size SHA256_DIGEST_SIZE but
@@ -1089,7 +1091,7 @@ int tpm2_load_null(struct tpm_chip *chip, u32 *null_key)
 	}
 
 	/* Try to re-create null key, given the integrity failure: */
-	rc = tpm2_create_primary(chip, TPM2_RH_NULL, &tmp_null_key, name);
+	rc = tpm2_create_primary(chip, TPM2_RH_NULL, &tmp_null_key, name, false);
 	if (rc)
 		goto err;
 
@@ -1396,6 +1398,7 @@ static int tpm2_parse_create_primary(struct tpm_chip *chip, struct tpm_buf *buf,
  * @hierarchy: The hierarchy handle to create under
  * @handle:    The returned volatile handle on success
  * @name:      The name of the returned key
+ * @audit:     Execute in the caller's HMAC audit session
  *
  * For platforms that might not have a persistent primary, this can be
  * used to create one quickly on the fly (it uses Elliptic Curve not
@@ -1410,7 +1413,7 @@ static int tpm2_parse_create_primary(struct tpm_chip *chip, struct tpm_buf *buf,
  * * TPM_RC	- A TPM error
  */
 static int tpm2_create_primary(struct tpm_chip *chip, u32 hierarchy,
-			       u32 *handle, u8 *name)
+			       u32 *handle, u8 *name, bool audit)
 {
 	struct tpm_buf *template __free(kfree) = NULL;
 	struct tpm_buf *buf __free(kfree) = NULL;
@@ -1476,8 +1479,16 @@ static int tpm2_create_primary(struct tpm_chip *chip, u32 hierarchy,
 	/* END parameters */
 
 	/* primary handle */
-	tpm_buf_append_u32(buf, hierarchy);
-	tpm_buf_append_empty_auth(buf, TPM2_RS_PW);
+	if (audit) {
+		rc = tpm_buf_append_name(chip, buf, hierarchy, NULL);
+		if (rc)
+			return rc;
+		tpm_buf_append_hmac_session(chip, buf, TPM2_SA_CONTINUE_SESSION,
+					    NULL, 0);
+	} else {
+		tpm_buf_append_u32(buf, hierarchy);
+		tpm_buf_append_empty_auth(buf, TPM2_RS_PW);
+	}
 
 	/* sensitive create size is 4 for two empty buffers */
 	tpm_buf_append_u16(buf, 4);
@@ -1497,8 +1508,15 @@ static int tpm2_create_primary(struct tpm_chip *chip, u32 hierarchy,
 	/* creation PCR (none) */
 	tpm_buf_append_u32(buf, 0);
 
+	if (audit) {
+		rc = tpm_buf_fill_hmac_session(chip, buf);
+		if (rc)
+			return rc;
+	}
 	rc = tpm_transmit_cmd(chip, buf, 0,
 			      "attempting to create NULL primary");
+	if (audit)
+		rc = tpm_buf_check_hmac_response(chip, buf, rc);
 
 	if (rc == TPM2_RC_SUCCESS)
 		rc = tpm2_parse_create_primary(chip, buf, handle, hierarchy,
@@ -1513,7 +1531,7 @@ static int tpm2_create_null_primary(struct tpm_chip *chip)
 	int rc;
 
 	rc = tpm2_create_primary(chip, TPM2_RH_NULL, &null_key,
-				 chip->null_key_name);
+				 chip->null_key_name, false);
 
 	if (rc == TPM2_RC_SUCCESS) {
 		unsigned int offset = 0; /* dummy offset for null key context */
@@ -1526,6 +1544,13 @@ static int tpm2_create_null_primary(struct tpm_chip *chip)
 	return rc;
 }
 
+int tpm2_create_audited_null(struct tpm_chip *chip, u32 *handle)
+{
+	u8 name[TPM2_NAME_SIZE];
+
+	return tpm2_create_primary(chip, TPM2_RH_NULL, handle, name, true);
+}
+
 /**
  * tpm2_sessions_init() - start of day initialization for the sessions code
  * @chip: TPM chip
@@ -1550,4 +1575,63 @@ int tpm2_sessions_init(struct tpm_chip *chip)
 
 	return rc;
 }
+
+#ifdef CONFIG_HIBERNATION_TPM_SIGNATURE
+/* Called with the chip's ops held, only after the complete image verifies. */
+int tpm2_hibernate_export(struct tpm_chip *chip,
+			  const u8 old_name[TPM2_NAME_SIZE])
+{
+	struct linux_efi_tpm_resume *resume = efi_tpm_resume_map();
+
+	if (!resume)
+		return -ENODEV;
+	WRITE_ONCE(resume->ready, 0);
+	memcpy(resume->old_name, old_name, sizeof(resume->old_name));
+	memcpy(resume->null_name, chip->null_key_name, sizeof(resume->null_name));
+	memcpy(resume->null_x, chip->null_ec_key_x, sizeof(resume->null_x));
+	memcpy(resume->null_y, chip->null_ec_key_y, sizeof(resume->null_y));
+	memcpy(resume->null_context, chip->null_key_context,
+	       sizeof(resume->null_context));
+	/* Publish the complete, authenticated, one-shot handoff last. */
+	smp_store_release(&resume->ready, 1);
+	memunmap(resume);
+	return 0;
+}
+
+/*
+ * Keep SUSPENDED set until the cached context has been replaced. Never derive
+ * a new TOFU key here: consume only the restore kernel's verified context,
+ * and only for the original NULL name bound into the signed RAM image.
+ */
+void tpm2_hibernate_import(struct tpm_chip *chip)
+{
+	struct linux_efi_tpm_resume *resume;
+
+	if (!(chip->flags & TPM_CHIP_FLAG_TPM2) ||
+	    (chip->flags & TPM_CHIP_FLAG_DISABLE))
+		return;
+	resume = efi_tpm_resume_map();
+	if (!resume)
+		return;
+	if (smp_load_acquire(&resume->ready) != 1 ||
+	    memcmp(resume->old_name, chip->null_key_name,
+		   sizeof(resume->old_name)))
+		goto out;
+	if (cmpxchg(&resume->ready, 1, 0) != 1)
+		goto out;
+	/* No TPM command may flush a stale handle from the pre-reset image. */
+	tpm2_free_auth(chip->auth);
+	chip->auth = NULL;
+	memcpy(chip->null_key_name, resume->null_name, sizeof(resume->null_name));
+	memcpy(chip->null_ec_key_x, resume->null_x, sizeof(resume->null_x));
+	memcpy(chip->null_ec_key_y, resume->null_y, sizeof(resume->null_y));
+	memcpy(chip->null_key_context, resume->null_context,
+	       sizeof(resume->null_context));
+	memzero_explicit(resume->old_name,
+			 sizeof(*resume) - offsetof(typeof(*resume), old_name));
+	dev_info(&chip->dev, "Restored authenticated NULL-primary context\n");
+out:
+	memunmap(resume);
+}
+#endif
 #endif /* CONFIG_TCG_TPM2_HMAC */
